# Copy this file to .env and fill in your own values.
#   cp .env.example .env
#
# .env is gitignored. Never commit real credentials.
# Every variable your code reads should appear here with a placeholder,
# so someone else knows what the project needs without having your keys.

# --- API credentials ---
CONGRESS_API_KEY=your_key_here
FEC_API_KEY=your_key_here
NEWSAPI_KEY=your_key_here

# --- Database ---
# Local development, via docker compose
DATABASE_URL=postgresql://postgres:postgres@db:5432/project

# Deployment: Render provides this as an environment variable.
# Do not put your Neon connection string in this file.

# --- Optional ---
LOG_LEVEL=INFO
